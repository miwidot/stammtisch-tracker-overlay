{
  "name": "tarkov-data-overlay",
  "version": "1.0.0",
  "description": "Community-maintained data overlay for tarkov.dev API corrections and additions",
  "type": "module",
  "scripts": {
    "validate": "tsx scripts/validate.ts",
    "build": "tsx scripts/build.ts",
    "build:check": "tsx scripts/build.ts --check",
    "next-overlay-tag": "node scripts/next-overlay-tag.cjs",
    "check-overrides": "tsx scripts/check-overrides.ts",
    "eft:compare": "tsx scripts/eft-compare.ts",
    "eft:audit": "tsx scripts/eft-audit.ts",
    "eft:coverage": "tsx scripts/eft-coverage.ts",
    "eft:diff": "tsx scripts/eft-diff.ts",
    "eft:import": "tsx scripts/eft-import.ts",
    "eft:remote": "tsx scripts/eft-remote.ts",
    "eft:extracts": "tsx scripts/eft-extracts.ts",
    "eft:wiki": "tsx scripts/eft-wiki-crosscheck.ts",
    "eft:normalize": "tsx scripts/eft-normalize.ts",
    "eft:story": "mkdir -p data/eft && tsx scripts/eft-story-wiki.ts && tsx scripts/eft-story-generate.ts > data/eft/story-final.json && tsx scripts/eft-story-write.ts",
    "tasks:availability": "tsx scripts/task-availability.ts",
    "wiki:compare": "tsx scripts/wiki-compare.ts",
    "audit:dependencies": "node scripts/audit-dependencies.cjs",
    "fallow:check": "fallow dead-code",
    "fallow:dupes": "fallow dupes",
    "fallow:audit": "fallow audit",
    "fallow:security": "fallow security",
    "lint:markdown": "node scripts/lint-markdown.mjs",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"**/*.{ts,cts,json,json5,md}\"",
    "format:check": "prettier --check \"**/*.{ts,cts,json,json5,md}\"",
    "test": "node --import tsx --experimental-test-module-mocks --test --test-reporter=dot \"tests/**/*.test.ts\"",
    "test:watch": "node --import tsx --experimental-test-module-mocks --test --watch \"tests/**/*.test.ts\"",
    "status:locale": "tsx scripts/status-locale.ts",
    "maintenance:ci": "tsx scripts/maintenance-ci.ts"
  },
  "keywords": [
    "tarkov",
    "escape-from-tarkov",
    "tarkov-dev",
    "api",
    "overlay",
    "data"
  ],
  "author": "Lab",
  "license": "(MIT AND CC-BY-NC-4.0)",
  "engines": {
    "node": ">=24.0.0"
  },
  "devDependencies": {
    "@sinonjs/fake-timers": "15.4.0",
    "@types/node": "24.19.2",
    "@types/sinonjs__fake-timers": "15.0.1",
    "@vitest/expect": "5.1.0",
    "@vitest/spy": "5.1.0",
    "ajv": "^8.20.0",
    "expect-type": "1.4.0",
    "fallow": "3.40.0",
    "json5": "^2.2.3",
    "markdownlint": "0.42.0",
    "prettier": "3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "katex": "0.18.9",
    "re2js": "2.8.8"
  }
}
