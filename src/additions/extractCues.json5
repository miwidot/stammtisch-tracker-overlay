      name: 'Gate m',
      cues: [{ type: 'key', item: '5448ba0b4bdc2d02308b456c' }],
      reference: 'https://escapefromtarkov.fandom.com/wiki/Factory#Extractions',
    },
    // Cellars
    f261d229a5b13a3292a4a49dced2a4949dfc342b: {
