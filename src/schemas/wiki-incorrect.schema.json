{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Wiki-incorrect suppressions",
  "type": "object",
  "propertyNames": { "pattern": "^[a-f0-9]{24}$" },
  "additionalProperties": {
    "type": "array",
    "items": { "type": "string", "minLength": 1 },
    "uniqueItems": true
  }
}
