{
  "$id": "extract-requirements.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Extract requirement rules",
  "description": "Generated by `npm run eft:extracts` from the game client's location and global definitions. Keyed by tarkov.dev map ID, then tarkov.dev extract ID.",
  "type": "object",
  "additionalProperties": false,
  "required": ["sources", "maps"],
  "properties": {
    "sources": {
      "description": "Client build and definitions hash of each capture mode the rules were generated from.",
      "type": "object",
      "additionalProperties": false,
      "required": ["regular"],
      "properties": {
        "regular": { "$ref": "#/definitions/source" },
        "pvp-season": { "$ref": "#/definitions/source" }
      }
    },
    "maps": {
      "type": "object",
      "propertyNames": { "pattern": "^[0-9a-f]{24}$" },
      "additionalProperties": {
        "type": "object",
        "propertyNames": { "pattern": "^[0-9a-f]{40}$" },
        "additionalProperties": { "$ref": "#/definitions/extract" }
      }
    }
  },
  "definitions": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clientBuild", "definitionsSha256"],
      "properties": {
        "clientBuild": { "type": "string", "pattern": "^\\d+(\\.\\d+){3,4}$" },
        "definitionsSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "extract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {
          "description": "Raw exit name the entry was matched on.",
          "type": "string",
          "minLength": 1
        },
        "rules": { "$ref": "#/definitions/ruleList" },
        "pvp": { "$ref": "#/definitions/ruleList" },
        "seasonal": { "$ref": "#/definitions/ruleList" }
      },
      "anyOf": [{ "required": ["rules"] }, { "required": ["pvp"] }, { "required": ["seasonal"] }]
    },
    "ruleList": {
      "type": "array",
      "items": { "$ref": "#/definitions/rule" }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "transfer",
            "coop",
            "activation",
            "empty",
            "train",
            "timer",
            "item",
            "chance",
            "unknown"
          ]
        },
        "item": { "type": "string", "pattern": "^[0-9a-f]{24}$" },
        "count": { "type": "number", "minimum": 0 },
        "countPve": { "type": "number", "minimum": 0 },
        "vehicle": { "type": "boolean" },
        "slot": { "type": "string", "minLength": 1 },
        "percent": { "type": "number", "minimum": 0, "maximum": 100 },
        "percentPve": { "type": "number", "minimum": 0, "maximum": 100 },
        "min": { "type": "number", "minimum": 0 },
        "max": { "type": "number", "minimum": 0 },
        "minPve": { "type": "number", "minimum": 0 },
        "maxPve": { "type": "number", "minimum": 0 }
      }
    }
  }
}
