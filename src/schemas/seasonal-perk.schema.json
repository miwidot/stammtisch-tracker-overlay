{
  "$id": "seasonal-perk.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Seasonal Perk Effects",
  "description": "Raw seasonal perk effects missing from tarkov.dev pvp-season/season. Perk metadata and translations come from upstream; supplements are keyed by BSG perk id.",
  "type": "object",
  "additionalProperties": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "effects"],
    "properties": {
      "id": {
        "description": "BSG perk id (matches the object key).",
        "type": "string"
      },
      "effects": {
        "description": "Effects the perk grants or imposes.",
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": true,
          "required": ["effectId"],
          "properties": {
            "effectId": {
              "description": "BSG effect identifier, e.g. \"pmc_experience_multiplicator\".",
              "type": "string",
              "minLength": 1,
              "not": {
                "const": "stub"
              }
            },
            "multiplicator": {
              "type": "number"
            },
            "multiplicatorPrimary": {
              "type": "number"
            },
            "multiplicatorSecondary": {
              "type": "number"
            },
            "intValue": {
              "type": "integer"
            },
            "skillIds": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "itemFilter": {
              "description": "Items/categories the effect applies to, matching tarkov.dev's served ItemFilters shape. Arrays of tarkov.dev ids: item template ids for items, item-category node ids for categories. Ids only - names resolve via tarkov.dev's locale system.",
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "allowedCategories": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "allowedItems": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "excludedCategories": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "excludedItems": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "minItems": 1
      }
    }
  }
}
